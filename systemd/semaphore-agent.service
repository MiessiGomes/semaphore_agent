[Unit]
Description=Semaphore Agent (daemon + UI)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/semaphore_agent/systemd.env
ExecStart=@PYTHON@ -m semaphore start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
